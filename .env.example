# Optional overrides for docker compose (defaults are safe for local use).
# Put them in .env (git-ignored) or pass --env-file. Secrets are NOT set here:
# run ./scripts/init-secrets.sh to create ./secrets/* (mode 0600).

# Public origin of the web UI as seen by your browser (used for CSRF/Origin checks).
PRICETRACKER_PUBLIC_ORIGIN=http://localhost:8090
# Loopback port for the web UI.
PRICETRACKER_PORT=8090
# Secure cookies also work on http://localhost in current browsers.
PRICETRACKER_COOKIE_SECURE=true
# First admin creation requires a one-time code: docker compose exec api pricetracker setup-code
PRICETRACKER_SETUP_REQUIRE_CODE=true
PRICETRACKER_ENVIRONMENT=production
PRICETRACKER_LOG_LEVEL=INFO

# LLM fallback (optional). Keys live in ./secrets/groq_api_key and ./secrets/openai_api_key.
PRICETRACKER_GROQ_MODEL=qwen/qwen3.8-27b

# Geocoding/routing. "manual" + "estimate" need no external service.
# To use a self-hosted OSRM: PRICETRACKER_ROUTER=osrm and PRICETRACKER_OSRM_URL=http://osrm:5000
PRICETRACKER_GEOCODER=manual
PRICETRACKER_NOMINATIM_CONTACT=
PRICETRACKER_ROUTER=estimate
PRICETRACKER_OSRM_URL=

PRICETRACKER_WORKER_CONCURRENCY=3
PRICETRACKER_DEFAULT_FRESHNESS_DAYS=7
